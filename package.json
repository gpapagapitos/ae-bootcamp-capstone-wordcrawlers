{
  "name": "wordcrawlers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Word-based roguelite capstone project",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "board:render": "node scripts/board.mjs render",
    "board:check": "node scripts/board-check.mjs",
    "board:add": "node scripts/board.mjs add",
    "board:move": "node scripts/board.mjs move",
    "board:note": "node scripts/board.mjs note",
    "board:owner": "node scripts/board.mjs owner",
    "board:done": "node scripts/board.mjs done",
    "handoff:snapshot": "node scripts/handoff.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.11",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "an-array-of-english-words": "^2.0.0",
    "pixi.js": "^8.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  }
}
